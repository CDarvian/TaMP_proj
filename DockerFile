# Используем официальный образ Ubuntu 18.04 как базовый
FROM ubuntu:18.04

# Устанавливаем временную зону (Москва) чтобы избежать запросов при установке пакетов
ENV TZ=Europe/Moscow
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Обновляем пакеты и устанавливаем необходимые зависимости:
# - build-essential: компилятор GCC, make и другие базовые инструменты сборки
# - qt5-default: базовые компоненты Qt5 (включает qmake)
# - qtcreator: IDE для разработки (опционально, можно удалить для production)
# - git: система контроля версий
# - cmake: альтернативная система сборки
# После установки очищаем кеш apt для уменьшения размера образа
RUN apt-get update && apt-get install -y \
    build-essential \
    qt5-default \
    qtcreator \
    git \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Создаем рабочую директорию в /usr/src/app (стандартный путь для приложений)
WORKDIR /usr/src/app

# Копируем все файлы из текущей директории в контейнер
# Включая исходный код сервера и .pro файл
COPY . .

# Отображаем содержимое директории для проверки (можно удалить в финальной версии)
RUN ls -la

# Собираем сервер:
# 1. qmake - создает Makefile на основе .pro файла
# 2. make - компилирует проект
RUN qmake echoServer.pro && make

# Открываем порт, который будет использовать сервер
EXPOSE 33333

# Указываем команду для запуска сервера при старте контейнера
CMD ["./echoServer"]
